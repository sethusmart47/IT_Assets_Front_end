{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "*.css",
      "*.js",
      "*.ico",
      "*.png",
      "*.svg",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.woff2",
      "*.woff",
      "*.ttf"
    ]
  },
  "globalHeaders": {
    "cache-control": "max-age=3600"
  }
}